# Copy this file to .env.local and fill in the keys.
# Clerk: https://dashboard.clerk.com → Your App → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_this_with_your_key

# Supabase → Project Settings → API. Use the anon key, never the service role.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
